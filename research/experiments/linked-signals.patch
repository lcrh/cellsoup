+++ b/tests/linked-signals.test.mjs
@@ -0,0 +1,52 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  parseTree,
+  compileTree,
+  packTree,
+  unpackTree,
+  printTree,
+  mutateTree,
+  randomTree,
+  treeRng,
+  TREE_VM_OPS,
+} from "../web/gpu/trees.js";
+test("linked expressions keep channel types, old opcodes and serialization", () => {
+  assert.equal(
+    TREE_VM_OPS.findIndex((o) => o[0] === "mem_load"),
+    46,
+  );
+  assert.equal(
+    TREE_VM_OPS.findIndex((o) => o[0] === "linked_listen"),
+    50,
+  );
+  assert.throws(() => parseTree("(move (couple 0 1))"), /Type mismatch/);
+  assert.throws(() => parseTree("(move (linked-signal m0))"), /Type mismatch/);
+  const tree = parseTree("(move (couple c2 (+ (linked-signal c1) 1)))"),
+    code = compileTree(tree),
+    packed = packTree(tree);
+  assert.match(code.source, /linked_listen r0 1/);
+  assert.match(code.source, /emit 2 r0\nlinked_listen r0 2\nmove r0/);
+  assert.equal(
+    printTree(unpackTree(packed.data, packed.count)),
+    printTree(tree),
+  );
+});
+test("linked forms arrive through mutation, not initial random programs", () => {
+  const rng = treeRng(904),
+    founders = Array.from({ length: 1000 }, () => randomTree(rng));
+  const ops = (t) => [t.op, ...t.args.flatMap(ops)];
+  assert.ok(
+    founders.every(
+      (t) => !ops(t).some((op) => ["couple", "linked-signal"].includes(op)),
+    ),
+  );
+  const parent = parseTree("(seq (photosynthesize) (move 1) (bud))"),
+    before = printTree(parent),
+    seen = new Set();
+  for (let i = 0; i < 4000; i++)
+    for (const op of ops(mutateTree(parent, rng))) seen.add(op);
+  assert.ok(seen.has("couple"));
+  assert.ok(seen.has("linked-signal"));
+  assert.equal(printTree(parent), before);
+});
