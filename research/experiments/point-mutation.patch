+// Experimental archive mutation: change one operation with the same typed
+// signature, preserving every argument and literal. No behavior-specific rules.
+export function pointMutateTree(tree, rng = Math.random) {
+  compileTree(tree);
+  const choices = [];
+  function visit(t, path = []) {
+    const spec = byName.get(t.op);
+    if (t.value === undefined) {
+      const alternatives = TREE_SCHEMA.filter(
+        (s) =>
+          s.name !== t.op &&
+          !["number", "bool", "slot", "channel"].includes(s.name) &&
+          s.result === spec.result &&
+          s.args.join(",") === spec.args.join(","),
+      );
+      if (alternatives.length) choices.push({ path, alternatives });
+    }
+    t.args.forEach((child, i) => visit(child, [...path, i]));
+  }
+  visit(tree);
+  if (!choices.length) return null;
+  // Compilation also checks lexical bindings and bounded temporary registers.
+  for (let attempt = 0; attempt < 64; attempt++) {
+    const choice = choices[Math.floor(rng() * choices.length)];
+    const result = clone(tree);
+    let target = result;
+    for (const i of choice.path) target = target.args[i];
+    target.op =
+      choice.alternatives[Math.floor(rng() * choice.alternatives.length)].name;
+    try {
+      compileTree(result);
+      return result;
+    } catch (error) {
+      if (!/limit|temporaries|64 instructions/.test(error.message)) throw error;
+    }
+  }
+  return null;
+}
