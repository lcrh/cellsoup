+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  randomTree,
+  treeRng,
+  pointMutateTree,
+  compileTree,
+  parseTree,
+  printTree,
+} from "../web/gpu/trees.js";
+import { createHash } from "node:crypto";
+function differences(a, b, out = []) {
+  assert.equal(a.value, b.value);
+  assert.equal(a.args.length, b.args.length);
+  if (a.op !== b.op) out.push([a.op, b.op]);
+  a.args.forEach((child, i) => differences(child, b.args[i], out));
+  return out;
+}
+test("point mutation changes exactly one operation and preserves all inputs", () => {
+  const rng = treeRng(1296);
+  let successful = 0;
+  for (let i = 0; i < 2000; i++) {
+    const tree = randomTree(rng),
+      before = structuredClone(tree);
+    const child = pointMutateTree(tree, rng);
+    assert.deepEqual(tree, before);
+    if (!child) continue;
+    successful++;
+    assert.equal(differences(tree, child).length, 1);
+    compileTree(child);
+  }
+  assert.ok(successful > 1800);
+});
+test("random founders remain byte-for-byte unchanged", () => {
+  const rng = treeRng(904),
+    hash = createHash("sha256");
+  for (let i = 0; i < 1000; i++)
+    hash.update(JSON.stringify(randomTree(rng)) + "\n");
+  assert.equal(
+    hash.digest("hex"),
+    "31ba18bc2f759a386134e76d3f98558386e5fd333189707bfbe07dac31e9d3b0",
+  );
+});
+test("a target predicate can change without discarding its target expression", () => {
+  const tree = parseTree("(if (alive (bond c2)) (photosynthesize) (eat))");
+  const rng = treeRng(11);
+  let found = false;
+  for (let i = 0; i < 100; i++) {
+    const child = pointMutateTree(tree, rng);
+    if (printTree(child) === "(if (kin (bond c2)) (photosynthesize) (eat))")
+      found = true;
+  }
+  assert.ok(found);
+});
